{
  "name": "schedule",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop sticker schedule — Electron + React",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "dev": "electron-vite dev",
    "compile": "electron-vite build",
    "build": "electron-vite build",
    "dist": "npm run compile && electron-builder --publish never",
    "dist:win": "npm run compile && electron-builder --win --publish never",
    "dist:linux": "npm run compile && electron-builder --linux --publish never",
    "preview": "electron-vite preview",
    "git:push": "bash scripts/git-save-push.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "design:lint": "design.md lint DESIGN.md",
    "design:export-tailwind": "design.md export --format tailwind DESIGN.md",
    "design:export-dtcg": "design.md export --format dtcg DESIGN.md"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "svg-plant": "^2.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@google/design.md": "^0.1.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.18",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
